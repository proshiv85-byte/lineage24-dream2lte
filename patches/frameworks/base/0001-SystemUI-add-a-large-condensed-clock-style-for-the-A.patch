+package com.android.systemui.keyguard.ui.view.layout.sections
+
+import android.animation.ValueAnimator
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.text.Editable
+import android.text.TextWatcher
+import android.text.format.DateFormat
+import android.util.TypedValue
+import android.view.View
+import android.widget.TextClock
+import androidx.constraintlayout.widget.ConstraintLayout
+import androidx.constraintlayout.widget.ConstraintSet
+import androidx.constraintlayout.widget.ConstraintSet.BOTTOM
+import androidx.constraintlayout.widget.ConstraintSet.END
+import androidx.constraintlayout.widget.ConstraintSet.MATCH_CONSTRAINT
+import androidx.constraintlayout.widget.ConstraintSet.PARENT_ID
+import androidx.constraintlayout.widget.ConstraintSet.START
+import androidx.constraintlayout.widget.ConstraintSet.TOP
+import androidx.constraintlayout.widget.ConstraintSet.WRAP_CONTENT
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.repeatOnLifecycle
+import com.android.app.tracing.coroutines.launchTraced as launch
+import com.android.systemui.doze.util.getBurnInOffset
+import com.android.systemui.keyguard.domain.interactor.KeyguardInteractor
+import com.android.systemui.keyguard.domain.interactor.KeyguardTransitionInteractor
+import com.android.systemui.keyguard.shared.model.KeyguardSection
+import com.android.systemui.keyguard.shared.model.KeyguardState
+import com.android.systemui.keyguard.ui.viewmodel.KeyguardClockViewModel
+import com.android.systemui.lifecycle.repeatWhenAttached
+import com.android.systemui.res.R
+import com.android.systemui.shade.ShadeDisplayAware
+import com.android.systemui.statusbar.policy.BatteryController
+import com.android.systemui.statusbar.policy.BatteryController.BatteryStateChangeCallback
+import java.util.Locale
+import javax.inject.Inject
+import kotlinx.coroutines.DisposableHandle
+import kotlinx.coroutines.awaitCancellation
+
+/**
+ * Always on display style with a large condensed clock, the date and a battery pill, centered in
+ * the upper part of the screen.
+ *
+ * It sits above the stock clock and smartspace and hides them with a black scrim while dozing. When
+ * the device wakes, the scrim fades out to reveal the stock lockscreen while the large clock
+ * shrinks and moves towards the stock clock.
+ */
+class AodStyleSection
+@Inject
+constructor(
+    @ShadeDisplayAware private val context: Context,
+    private val keyguardInteractor: KeyguardInteractor,
+    private val transitionInteractor: KeyguardTransitionInteractor,
+    private val clockViewModel: KeyguardClockViewModel,
+    private val batteryController: BatteryController,
+) : KeyguardSection() {
+
+    private lateinit var scrim: View
+    private lateinit var clock: TextClock
+    private lateinit var date: TextClock
+    private lateinit var battery: BatteryPillView
+    private var bindingDisposable: DisposableHandle? = null
+
+    /** 1 while dozing, 0 on the lockscreen; follows the AOD transition. */
+    private var aodAmount = 0f
+    /** Fades the style out while a notification pulses, so the stock pulse UI shows. */
+    private var pulseAlpha = 1f
+    private var pulseAnimator: ValueAnimator? = null
+    private var burnInX = 0
+    private var burnInY = 0
+
+    private val content: List<View>
+        get() = listOf(clock, date, battery)
+
+    override fun addViews(constraintLayout: ConstraintLayout) {
+        val metrics = context.resources.displayMetrics
+        val shortSide = minOf(metrics.widthPixels, metrics.heightPixels)
+
+        scrim =
+            View(context).apply {
+                id = R.id.aod_style_scrim
+                setBackgroundColor(Color.BLACK)
+                importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
+            }
+        clock =
+            TextClock(context).apply {
+                id = R.id.aod_style_clock
+                format12Hour = "h:mm"
+                format24Hour = "HH:mm"
+                typeface = Typeface.create(CLOCK_FONT_FAMILY, Typeface.NORMAL)
+                fontVariationSettings = CLOCK_FONT_VARIATIONS
+                setTextSize(TypedValue.COMPLEX_UNIT_PX, shortSide * CLOCK_SIZE_FRACTION)
+                letterSpacing = CLOCK_LETTER_SPACING
+                includeFontPadding = false
+                setTextColor(Color.WHITE)
+                importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
+                // The time changes once a minute: move the burn-in offset along with it.
+                addTextChangedListener(
+                    object : TextWatcher {
+                        override fun beforeTextChanged(s: CharSequence?, a: Int, b: Int, c: Int) {}
+
+                        override fun onTextChanged(s: CharSequence?, a: Int, b: Int, c: Int) {}
+
+                        override fun afterTextChanged(s: Editable?) = updateBurnIn()
+                    }
+                )
+            }
+        date =
+            TextClock(context).apply {
+                id = R.id.aod_style_date
+                val pattern = DateFormat.getBestDateTimePattern(Locale.getDefault(), "EEEEMMMd")
+                format12Hour = pattern
+                format24Hour = pattern
+                typeface = Typeface.create(CLOCK_FONT_FAMILY, Typeface.NORMAL)
+                fontVariationSettings = "'wght' 450"
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 20f)
+                includeFontPadding = false
+                setTextColor(Color.WHITE)
+                importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
+            }
+        battery = BatteryPillView(context).apply { id = R.id.aod_style_battery }
+
+        (listOf(scrim) + content).forEach {
+            it.visibility = View.INVISIBLE
+            constraintLayout.addView(it)
+        }
+    }
+
+    override fun bindData(constraintLayout: ConstraintLayout) {
+        bindingDisposable?.dispose()
+        bindingDisposable =
+            scrim.repeatWhenAttached {
+                repeatOnLifecycle(Lifecycle.State.CREATED) {
+                    launch("$TAG#aodAmount") {
+                        transitionInteractor.transitionValue(KeyguardState.AOD).collect {
+                            aodAmount = it
+                            apply()
+                        }
+                    }
+                    launch("$TAG#isPulsing") {
+                        keyguardInteractor.isPulsing.collect { animatePulse(it) }
+                    }
+                    launch("$TAG#battery") {
+                        val callback =
+                            object : BatteryStateChangeCallback {
+                                override fun onBatteryLevelChanged(
+                                    level: Int,
+                                    pluggedIn: Boolean,
+                                    charging: Boolean,
+                                ) {
+                                    battery.level = level
+                                }
+                            }
+                        batteryController.addCallback(callback)
+                        try {
+                            awaitCancellation()
+                        } finally {
+                            batteryController.removeCallback(callback)
+                        }
+                    }
+                }
+            }
+    }
+
+    override fun applyConstraints(constraintSet: ConstraintSet) {
+        val metrics = context.resources.displayMetrics
+        val height = maxOf(metrics.widthPixels, metrics.heightPixels)
+        val dp = metrics.density
+        constraintSet.apply {
+            connect(scrimId, TOP, PARENT_ID, TOP)
+            connect(scrimId, START, PARENT_ID, START)
+            connect(scrimId, END, PARENT_ID, END)
+            constrainWidth(scrimId, MATCH_CONSTRAINT)
+            constrainHeight(scrimId, (height * SCRIM_HEIGHT_FRACTION).toInt())
+
+            content.forEach {
+                constrainWidth(it.id, WRAP_CONTENT)
+                constrainHeight(it.id, WRAP_CONTENT)
+                connect(it.id, START, PARENT_ID, START)
+                connect(it.id, END, PARENT_ID, END)
+            }
+            connect(clockId, TOP, PARENT_ID, TOP, (height * CLOCK_TOP_FRACTION).toInt())
+            connect(dateId, TOP, clockId, BOTTOM, (4 * dp).toInt())
+            connect(batteryId, TOP, dateId, BOTTOM, (10 * dp).toInt())
+        }
+    }
+
+    override fun removeViews(constraintLayout: ConstraintLayout) {
+        bindingDisposable?.dispose()
+        pulseAnimator?.cancel()
+        (listOf(scrim) + content).forEach { constraintLayout.removeView(it) }
+    }
+
+    private fun animatePulse(pulsing: Boolean) {
+        pulseAnimator?.cancel()
+        pulseAnimator =
+            ValueAnimator.ofFloat(pulseAlpha, if (pulsing) 0f else 1f).apply {
+                duration = PULSE_FADE_DURATION_MS
+                addUpdateListener {
+                    pulseAlpha = it.animatedValue as Float
+                    apply()
+                }
+                start()
+            }
+    }
+
+    private fun updateBurnIn() {
+        val res = context.resources
+        val amplitudeX = res.getDimensionPixelSize(R.dimen.burn_in_prevention_offset_x)
+        val amplitudeY = res.getDimensionPixelSize(R.dimen.burn_in_prevention_offset_y)
+        burnInX = getBurnInOffset(amplitudeX * 2, true) - amplitudeX
+        burnInY = getBurnInOffset(amplitudeY * 2, false) - amplitudeY
+        apply()
+    }
+
+    private fun apply() {
+        val amount = aodAmount * pulseAlpha
+        val visibility = if (amount > 0f) View.VISIBLE else View.INVISIBLE
+        (listOf(scrim) + content).forEach { it.visibility = visibility }
+        if (amount <= 0f) return
+
+        scrim.alpha = amount
+        // The content fades a little ahead of the scrim, so the stock clock shows up underneath
+        // while the large clock is still moving towards it.
+        val contentAlpha = ((amount - CONTENT_FADE_START) / (1f - CONTENT_FADE_START)).coerceIn(0f, 1f)
+
+        // Shrink and move towards the stock clock while waking up.
+        val progress = 1f - aodAmount
+        var scale = 1f
+        var dx = 0f
+        var dy = 0f
+        stockClockView()?.let { stock ->
+            if (stock.isLaidOut && clock.isLaidOut && clock.height > 0) {
+                val stockLocation = IntArray(2).also { stock.getLocationInWindow(it) }
+                val parentLocation =
+                    IntArray(2).also { (clock.parent as View).getLocationInWindow(it) }
+                val stockCenterX = stockLocation[0] + stock.width * stock.scaleX / 2f
+                val stockCenterY = stockLocation[1] + stock.height * stock.scaleY / 2f
+                val clockCenterX = parentLocation[0] + clock.left + clock.width / 2f
+                val clockCenterY = parentLocation[1] + clock.top + clock.height / 2f
+                val targetScale =
+                    (stock.height * stock.scaleY / clock.height).coerceIn(MIN_SCALE, 1f)
+                scale = lerp(1f, targetScale, progress)
+                dx = (stockCenterX - clockCenterX) * progress
+                dy = (stockCenterY - clockCenterY) * progress
+            }
+        }
+
+        clock.scaleX = scale
+        clock.scaleY = scale
+        // Keep the date and battery attached to the bottom of the shrinking clock.
+        val clockShrink = clock.height * (1f - scale) / 2f
+        content.forEach {
+            it.alpha = contentAlpha
+            it.translationX = burnInX + dx
+            it.translationY = burnInY + dy - if (it === clock) 0f else clockShrink
+        }
+    }
+
+    private fun stockClockView(): View? {
+        val controller = clockViewModel.currentClock.value ?: return null
+        return if (clockViewModel.isLargeClockVisible.value) controller.largeClock.view
+        else controller.smallClock.view
+    }
+
+    private fun lerp(start: Float, end: Float, fraction: Float) = start + (end - start) * fraction
+
+    /** An outlined battery with the level inside, like a status bar battery pill. */
+    private class BatteryPillView(context: Context) : View(context) {
+        private val dp = resources.displayMetrics.density
+        private val strokeWidth = 1.7f * dp
+        private val bodyWidth = 30f * dp
+        private val bodyHeight = 16f * dp
+        private val nubWidth = 2.5f * dp
+        private val nubHeight = 6f * dp
+        private val body = RectF()
+        private val nub = RectF()
+
+        private val outlinePaint =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                style = Paint.Style.STROKE
+                strokeWidth = this@BatteryPillView.strokeWidth
+                color = Color.WHITE
+            }
+        private val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.WHITE }
+        private val textPaint =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                color = Color.WHITE
+                textAlign = Paint.Align.CENTER
+                textSize = 11f * resources.displayMetrics.scaledDensity
+                typeface = Typeface.create(CLOCK_FONT_FAMILY, Typeface.NORMAL)
+                fontVariationSettings = "'wght' 650"
+            }
+
+        var level = 0
+            set(value) {
+                if (field != value) {
+                    field = value
+                    invalidate()
+                }
+            }
+
+        init {
+            importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_NO
+        }
+
+        override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+            setMeasuredDimension(
+                (bodyWidth + nubWidth + strokeWidth * 2).toInt(),
+                (bodyHeight + strokeWidth * 2).toInt(),
+            )
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            val half = strokeWidth / 2f
+            body.set(half, half, bodyWidth + half, bodyHeight + half)
+            canvas.drawRoundRect(body, 4.5f * dp, 4.5f * dp, outlinePaint)
+            nub.set(
+                body.right + strokeWidth / 2f,
+                body.centerY() - nubHeight / 2f,
+                body.right + strokeWidth / 2f + nubWidth,
+                body.centerY() + nubHeight / 2f,
+            )
+            canvas.drawRoundRect(nub, dp, dp, fillPaint)
+            val baseline = body.centerY() - (textPaint.descent() + textPaint.ascent()) / 2f
+            canvas.drawText(level.toString(), body.centerX(), baseline, textPaint)
+        }
+    }
+
+    companion object {
+        private const val TAG = "AodStyleSection"
+
+        private val scrimId = R.id.aod_style_scrim
+        private val clockId = R.id.aod_style_clock
+        private val dateId = R.id.aod_style_date
+        val batteryId = R.id.aod_style_battery
+
+        private const val CLOCK_FONT_FAMILY = "roboto-flex"
+        /** Narrowest width, display optical size and tall figures: a condensed clock. */
+        private const val CLOCK_FONT_VARIATIONS = "'wdth' 25, 'wght' 560, 'opsz' 144, 'YTFI' 788"
+        private const val CLOCK_SIZE_FRACTION = 0.326f
+        private const val CLOCK_LETTER_SPACING = 0.04f
+        private const val CLOCK_TOP_FRACTION = 0.2f
+        /** The scrim covers the stock clock, smartspace and AOD notification area. */
+        private const val SCRIM_HEIGHT_FRACTION = 0.62f
+        private const val CONTENT_FADE_START = 0.3f
+        private const val MIN_SCALE = 0.15f
+        private const val PULSE_FADE_DURATION_MS = 200L
+    }
